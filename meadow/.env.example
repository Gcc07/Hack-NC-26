# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Flask Meadow API.
# - Laptop + local Flask: http://127.0.0.1:5000
# - meadow on the SAME web server as gunicorn: http://127.0.0.1:5000
# - meadow on a different machine: https://your-public-domain (no trailing slash)
# Defaults to http://127.0.0.1:5000 if unset. Set to "off" to disable Flask sync.
BACKEND_URL=http://127.0.0.1:5000

# HTTP bridge for the browser (js/imessage.js).
BRIDGE_PORT=5055
# dry = log texts in the terminal (safe). live = send real iMessages.
BRIDGE_MODE=dry

# Must match MEADOW_BRIDGE_SECRET in the repo-root .env (Flask auth bypass for this process).
MEADOW_BRIDGE_SECRET=

# GEMINI_API_KEY lives in the repo-root .env (Flask /api/ai/*). Never commit keys.
