# systemd unit for running Meadow with gunicorn on Ubuntu/Debian EC2.
#
# Install:
#   sudo cp deploy/meadow.service /etc/systemd/system/meadow.service
#   (edit User / paths below if your username or clone location differs)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now meadow
#
# Logs:    journalctl -u meadow -f
# Update:  git pull && sudo systemctl restart meadow
#
# Worker count: with STORAGE_BACKEND=memory every worker has its own separate
# data, so keep a single worker. With STORAGE_BACKEND=tiger the data lives in
# the database, so you may raise --workers (for example to 2-4).

[Unit]
Description=Meadow Flask app (gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Hack-NC-26
# .env (STORAGE_BACKEND, DATABASE_URL, ...) is loaded by the app from the repo root.
ExecStart=/home/ubuntu/Hack-NC-26/.venv/bin/gunicorn \
    --workers 1 --threads 4 \
    --bind 127.0.0.1:5000 \
    --access-logfile - \
    "app:app"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
