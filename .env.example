# This file contains environmental variables for use with your Tiger Cloud instance
TIMESCALE_SERVICE_URL=
# The above service url can be used to connect to your Tiger Cloud instance.
# For example, in Python, you can load this variable with:
#
# !pip install python-dotenv
# import os
# from dotenv import load_dotenv, find_dotenv
# _ = load_dotenv(find_dotenv())
# TIMESCALE_SERVICE_URL=os.environ["TIMESCALE_SERVICE_URL"]
#
# Note: You will need to install the python-dotenv (https://github.com/theskumar/python-dotenv)
#
# Then, you can connect to your Tiger Cloud instance using the service url in the
# same places you would provide a PostgreSQL connection string (also referred to
# as a postgres URL/URI/DSN). For instance:
# Timescale-vector: client.Sync(service_url=os.environ["TIMESCALE_SERVICE_URL"])
# psycopg2: psycopg2.connect(dsn=os.environ["TIMESCALE_SERVICE_URL"])
# asyncpg: asyncpg.create_pool(dsn=os.environ["TIMESCALE_SERVICE_URL"])
#
# To connect to the database using psql please use:
# psql "postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require"
#
# We also define standard postgres environmental variables below. They can
# be used with a variety of tools.
PGPASSWORD=
PGUSER=
PGDATABASE=
PGHOST=
PGPORT=
PGSSLMODE=
# These can be loaded into your shell using a variety of utiities.
# For example, you can use dotenv-cli: https://github.com/venthur/dotenv-cli

# ---------------------------------------------------------------- Meadow
# memory = no database (local demo); tiger = use TIMESCALE_SERVICE_URL above.
# After switching to tiger, run once: flask --app app tiger-init
STORAGE_BACKEND=tiger

# Optional: BM25 search when pg_textsearch is available (auto or off).
TIGER_SEARCH_BM25=auto

# Optional: Google Gemini (https://aistudio.google.com/apikey).
# Upgrades Dewey's request parsing and chat summaries, and enables semantic
# memory search (run flask --app app tiger-index-memory after setting it).
# Leave blank to use the offline parser and keyword search.
GEMINI_API_KEY=
# ---------------------------------------------------------------- Accounts and sign-in
# Required for real use: signs Google sign-in state and encrypts stored Google
# Calendar refresh tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later invalidates stored calendar access (users reconnect once).
MEADOW_SECRET_KEY=

# Set both to 1 when deployed behind nginx with HTTPS (deploy/nginx-meadow.conf):
# trusts X-Forwarded-* from one proxy hop and marks cookies Secure.
MEADOW_BEHIND_PROXY=
MEADOW_SECURE_COOKIES=

# Optional: Sign in with Google + Google Calendar free/busy access.
# Google Cloud Console > APIs & Services:
#   1. Enable the Google Calendar API.
#   2. OAuth consent screen: add the scopes openid, email, profile and
#      https://www.googleapis.com/auth/calendar.freebusy
#   3. Credentials > OAuth client ID > Web application. Authorized redirect URIs:
#        http://localhost:5000/api/auth/google/callback
#        https://yourname.tech/api/auth/google/callback
# GOOGLE_REDIRECT_URI overrides the callback URL derived from the request.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered with Google. Local dev value below;
# in production use https://yourname.tech/api/auth/google/callback (your real domain).
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
