# Copy this file to .env. Never commit real credentials.
# No database or paid services are required for the default local demo.
STORAGE_BACKEND=memory

# Tiger Cloud: PostgreSQL 17+ service with TimescaleDB enabled.
# To use it, set STORAGE_BACKEND=tiger and fill in DATABASE_URL below.
#
# Format:
#   postgres://tsdbadmin:<PASSWORD>@<HOST>:<PORT>/tsdb?sslmode=require
#
# Tiger Cloud only shows the tsdbadmin password once, when the service is
# created (it's also in the credentials file you could download then).
# Lost it? In the Tiger Cloud console, open your service, reset the password, and copy
# the new one. Replace <PASSWORD> with it (no angle brackets), and
# URL-encode special characters (@ -> %40, # -> %23, / -> %2F, : -> %3A).
# Note: the value is sslmode=require, not "required".
DATABASE_URL=
# After saving this file as .env:
#   flask --app app tiger-init
# Optional, with GEMINI_API_KEY set: flask --app app tiger-index-memory

# Optional: BM25 search when pg_textsearch is available (auto or off).
TIGER_SEARCH_BM25=auto

# Optional: Google Gemini (https://aistudio.google.com/apikey).
# Upgrades Dewey's request parsing and chat summaries, and enables semantic
# memory search (run flask --app app tiger-index-memory after setting it).
# Leave blank to use the offline parser and keyword search.
GEMINI_API_KEY=
