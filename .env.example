# Copy this file to .env. Never commit real credentials.
# No database or paid services are required for the default local demo.
STORAGE_BACKEND=memory

# Tiger Cloud: PostgreSQL 17+ service with TimescaleDB enabled.
# Set STORAGE_BACKEND=tiger and paste the service's connection string here.
# Keep sslmode=require for Tiger Cloud. URL-encode special password characters.
DATABASE_URL=
# After saving this file as .env:
#   flask --app app tiger-init
# Optional embeddings, then: flask --app app tiger-index-memory

# Optional: BM25 search when pg_textsearch is available (auto or off).
TIGER_SEARCH_BM25=auto

# Optional: real semantic embeddings, used only after explicit indexing.
# Configure an OpenAI-compatible /embeddings endpoint and run tiger-index-memory.
# Only org memory documents and search queries are sent, never private calendars.
MEADOW_EMBEDDING_URL=
MEADOW_EMBEDDING_MODEL=
MEADOW_EMBEDDING_API_KEY=
